# ─────────────────────────────────────────────
#  LLM — OpenAI
# ─────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o           # or gpt-4-turbo, gpt-4o-mini
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.3

# ─────────────────────────────────────────────
#  Telegram Delivery
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here

# ─────────────────────────────────────────────
#  Email Delivery (optional)
# ─────────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password      # Use Gmail App Password, not account password
EMAIL_FROM=your-email@gmail.com
EMAIL_TO=recipient@email.com

# ─────────────────────────────────────────────
#  Scheduler
# ─────────────────────────────────────────────
REPORT_TIME=07:00                    # 24-hour format
TIMEZONE=Asia/Jakarta                # pytz timezone string

# ─────────────────────────────────────────────
#  Article Fetching & Scoring
# ─────────────────────────────────────────────
MAX_ARTICLES=30                      # Max articles fetched per run
TOP_ARTICLES_COUNT=7                 # Top-scored articles sent to LLM
MIN_ARTICLE_SCORE=3.0                # Minimum combined score to keep an article
